# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (sb_publishable_...) from Project Settings → API Keys. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The public address of the site (used in emails and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Localhost only (npm run dev): sign in with a fixed code, no email.
# The secret key is from Supabase → Project Settings → API Keys. Keep it ONLY in .env.local. Never set these on Vercel.
# DEV_LOGIN_CODE=123456
# SUPABASE_SECRET_KEY=
