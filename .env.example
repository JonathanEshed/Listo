# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (sb_publishable_...) from Project Settings → API Keys. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The public address of the site (used in emails and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only (npm run dev). A fixed sign-in code instead of the email code.
# DEV_LOGIN_PASSWORD must be a long random string (at least 16 characters). Never set these on Vercel.
# DEV_LOGIN_CODE=123456
# DEV_LOGIN_PASSWORD=
